      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg: #010b13;\n    --bg-soft: #08131d;\n    --panel: rgba(255, 255, 255, 0.04);\n    --panel-strong: rgba(255, 255, 255, 0.07);\n    --line: rgba(255, 255, 255, 0.1);\n    --cyan: #0fffff;\n    --magenta: #bf00ff;\n    --text: #f6fbff;\n    --text-soft: rgba(255, 255, 255, 0.7);\n    --shadow-cyan: 0 0 30px rgba(15, 255, 255, 0.18);\n  }\n\n  body {\n    background-color: var(--bg);\n    color: var(--text);\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-heading {\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  /* Custom Scrollbar */\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 6px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: 10px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n    background: rgba(255, 255, 255, 0.2);\n  }\n\n  /* Neon Inset Glow Utility */\n  .neon-inset {\n    box-shadow: 0 0 20px rgba(15, 255, 255, 0.08), inset 0 0 25px rgba(15, 255, 255, 0.03);\n  }\n  \n  .neon-glow-cyan {\n    box-shadow: 0 0 30px rgba(15, 255, 255, 0.35);\n  }\n\n  .tech-card {\n    background-image: linear-gradient(rgba(255, 255, 255, 0.01) 1px, transparent 1px);\n    background-size: 100% 4px;\n  }\n\n  /* Gradient Border Wrapper */\n  .gradient-border-wrap {\n    position: relative;\n    padding: 1px;\n    background: linear-gradient(135deg, rgba(15, 255, 255, 0.3), rgba(191, 0, 255, 0.3));\n    border-radius: 18px;\n  }\n\n  .gradient-border-inner {\n    background: var(--bg-soft);\n    border-radius: 17px;\n  }\n\n  /* Floating Dock Animation */\n  @keyframes floatUp {\n    from { transform: translate(-50%, 20px); opacity: 0; }\n    to { transform: translate(-50%, 0); opacity: 1; }\n  }\n  .animate-float-up {\n    animation: floatUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n  }\n</style>\n\n<div class=\"flex min-h-[950px] w-full bg-[#010B13] text-[#f6fbff] relative overflow-hidden\" data-kid=\"1\">\n  \n  <div class=\"absolute -top-[10%] -left-[5%] w-[500px] h-[500px] bg-[#0fffff]/10 rounded-full blur-[140px] pointer-events-none\" data-kid=\"2\"></div>\n  <div class=\"absolute -bottom-[10%] -right-[5%] w-[600px] h-[600px] bg-[#bf00ff]/10 rounded-full blur-[160px] pointer-events-none\" data-kid=\"3\"></div>\n\n  \n  <aside class=\"w-[72px] border-r border-white/10 flex flex-col items-center py-8 gap-10 bg-[#010b13]/80 backdrop-blur-xl z-50\" data-kid=\"4\">\n    \n    <div class=\"w-11 h-11 rounded-xl bg-gradient-to-br from-[#0fffff] to-[#bf00ff] p-[1px] shadow-[0_0_20px_rgba(15,255,255,0.3)]\" data-kid=\"5\">\n      <div class=\"w-full h-full bg-[#010b13] rounded-[10px] flex items-center justify-center\" data-kid=\"6\">\n        <i class=\"ti ti-sparkles text-[#0fffff] text-2xl\" data-kid=\"7\"></i>\n      </div>\n    </div>\n    \n    <nav class=\"flex flex-col gap-6\" data-kid=\"8\">\n      <button class=\"group relative w-12 h-12 rounded-xl bg-[#0fffff]/10 border border-[#0fffff]/30 text-[#0fffff] flex items-center justify-center transition-all hover:bg-[#0fffff]/20 hover:scale-105\" title=\"Workspace\" data-kid=\"9\">\n        <i class=\"ti ti-layout-dashboard text-2xl\" data-kid=\"10\"></i>\n        <div class=\"absolute left-16 px-2 py-1 bg-[#0fffff] text-[#010b13] text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none uppercase whitespace-nowrap tracking-wider shadow-[0_0_10px_rgba(15,255,255,0.4)]\" data-kid=\"11\">Workspace</div>\n      </button>\n      <button class=\"group relative w-12 h-12 rounded-xl text-white/40 flex items-center justify-center transition-all hover:text-white hover:bg-white/5 hover:scale-105\" title=\"History\" data-kid=\"12\">\n        <i class=\"ti ti-history text-2xl\" data-kid=\"13\"></i>\n      </button>\n      <button class=\"group relative w-12 h-12 rounded-xl text-white/40 flex items-center justify-center transition-all hover:text-white hover:bg-white/5 hover:scale-105\" title=\"Wallet\" data-kid=\"14\">\n        <i class=\"ti ti-wallet text-2xl\" data-kid=\"15\"></i>\n      </button>\n      <button class=\"group relative w-12 h-12 rounded-xl text-white/40 flex items-center justify-center transition-all hover:text-white hover:bg-white/5 hover:scale-105\" title=\"Profile\" data-kid=\"16\">\n        <i class=\"ti ti-user text-2xl\" data-kid=\"17\"></i>\n      </button>\n    </nav>\n    \n    <div class=\"mt-auto\" data-kid=\"18\">\n      <button class=\"group relative w-12 h-12 rounded-xl text-white/30 flex items-center justify-center transition-all hover:text-red-400 hover:bg-red-400/5\" title=\"Logout\" data-kid=\"19\">\n        <i class=\"ti ti-logout-2 text-2xl\" data-kid=\"20\"></i>\n      </button>\n    </div>\n  </aside>\n\n  \n  <div class=\"flex-1 flex flex-col relative z-10\" data-kid=\"21\">\n    \n    \n    <header class=\"h-14 border-b border-white/5 bg-[#010b13]/60 backdrop-blur-lg flex items-center justify-between px-8 sticky top-0 z-40\" data-kid=\"22\">\n      <div class=\"flex items-center gap-3\" data-kid=\"23\">\n        <span class=\"text-white/30 text-[10px] font-black uppercase tracking-widest\" data-kid=\"24\">Dash</span>\n        <i class=\"ti ti-point-filled text-[#0fffff] text-[10px]\" data-kid=\"25\"></i>\n        <span class=\"text-white/30 text-[10px] font-black uppercase tracking-widest\" data-kid=\"26\">Generate</span>\n        <i class=\"ti ti-point-filled text-[#0fffff] text-[10px]\" data-kid=\"27\"></i>\n        <span class=\"text-[#0fffff] text-[10px] font-black uppercase tracking-widest\" data-kid=\"28\">Concise Workspace</span>\n      </div>\n      \n      <div class=\"flex items-center gap-6\" data-kid=\"29\">\n        \n        <div class=\"flex items-center gap-3 bg-white/5 border border-white/10 rounded-full py-1 pl-4 pr-1.5 hover:border-[#0fffff]/30 transition-all cursor-pointer\" data-kid=\"30\">\n          <div class=\"flex flex-col items-end\" data-kid=\"31\">\n            <span class=\"text-[8px] text-white/40 leading-none uppercase tracking-[0.2em] font-extrabold\" data-kid=\"32\">Account Balance</span>\n            <span class=\"text-xs font-bold text-white leading-tight\" data-kid=\"33\">Rp452.800</span>\n          </div>\n          <div class=\"w-7 h-7 rounded-full bg-[#0fffff]/10 flex items-center justify-center border border-[#0fffff]/20 text-[#0fffff]\" data-kid=\"34\">\n            <i class=\"ti ti-wallet text-sm\" data-kid=\"35\"></i>\n          </div>\n        </div>\n        \n        <div class=\"h-6 w-px bg-white/10\" data-kid=\"36\"></div>\n        \n        \n        <div class=\"flex items-center gap-3\" data-kid=\"37\">\n          <div class=\"text-right hidden sm:block\" data-kid=\"38\">\n            <p class=\"text-[11px] font-bold text-white leading-none\" data-kid=\"39\">Jane Cooper</p>\n            <p class=\"text-[9px] text-white/40 leading-none mt-1 uppercase tracking-tighter\" data-kid=\"40\">Pro Creator</p>\n          </div>\n          <div class=\"w-8 h-8 rounded-full border border-[#0fffff]/40 p-0.5 shadow-[0_0_10px_rgba(15,255,255,0.2)]\" data-kid=\"41\">\n            <img src=\"https://i.pravatar.cc/100?u=jane\" class=\"w-full h-full rounded-full object-cover\" alt=\"User avatar\" decoding=\"async\" loading=\"lazy\" data-kid=\"42\">\n          </div>\n        </div>\n      </div>\n    </header>\n\n    \n    <div class=\"flex flex-1 overflow-hidden\" data-kid=\"43\">\n      \n      \n      <main class=\"w-[70%] p-10 overflow-y-auto custom-scrollbar\" data-kid=\"44\">\n        <div class=\"max-w-3xl mx-auto\" data-kid=\"45\">\n          \n          \n          <div class=\"mb-10\" data-kid=\"46\">\n            <div class=\"inline-flex items-center gap-2 px-2 py-0.5 rounded bg-[#0fffff]/10 border border-[#0fffff]/20 text-[9px] font-black text-[#0fffff] uppercase tracking-[0.2em] mb-3\" data-kid=\"47\">\n              <i class=\"ti ti-shield-bolt\" data-kid=\"48\"></i> Single Job Pipeline\n            </div>\n            <h1 class=\"text-3xl font-heading font-extrabold text-white tracking-tight mb-2\" data-kid=\"49\">Automated Voice Synthesis</h1>\n            <p class=\"text-white/40 text-sm max-w-xl leading-relaxed\" data-kid=\"50\">Konfigurasi materi audio-visual untuk hasil voice over profesional dengan engine AI generasi terbaru.</p>\n          </div>\n\n          <form class=\"space-y-8\" data-kid=\"51\">\n            \n            <div class=\"space-y-3\" data-kid=\"52\">\n              <label class=\"text-[10px] font-black text-white/40 uppercase tracking-[0.25em] px-1\" data-kid=\"53\">Source Material</label>\n              <div class=\"group relative\" data-kid=\"54\">\n                <div class=\"absolute -inset-[1px] bg-gradient-to-r from-[#0fffff]/40 to-[#bf00ff]/40 rounded-2xl blur-sm opacity-0 group-hover:opacity-100 transition duration-500\" data-kid=\"55\"></div>\n                <div class=\"relative bg-[#08131d]/80 border-2 border-dashed border-white/10 rounded-2xl p-6 flex items-center justify-between transition-all group-hover:border-[#0fffff]/50 cursor-pointer tech-card\" data-kid=\"56\">\n                  <div class=\"flex items-center gap-5\" data-kid=\"57\">\n                    <div class=\"w-14 h-14 rounded-2xl bg-[#0fffff]/10 flex items-center justify-center text-[#0fffff] shadow-[inset_0_0_15px_rgba(15,255,255,0.1)] border border-[#0fffff]/20\" data-kid=\"58\">\n                      <i class=\"ti ti-cloud-upload text-3xl\" data-kid=\"59\"></i>\n                    </div>\n                    <div data-kid=\"60\">\n                      <h4 class=\"font-bold text-white text-base tracking-tight\" data-kid=\"61\">Unggah Video (.mp4 / .mov)</h4>\n                      <p class=\"text-xs text-white/40 mt-1 font-medium italic\" data-kid=\"62\">Max size: 500MB • Recom: 1080p HEVC</p>\n                    </div>\n                  </div>\n                  <div class=\"flex flex-col items-end gap-3\" data-kid=\"63\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"64\">\n                       <span class=\"w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse\" data-kid=\"65\"></span>\n                       <span class=\"text-[9px] font-black text-green-400/80 uppercase tracking-widest\" data-kid=\"66\">Interface Ready</span>\n                    </div>\n                    <button type=\"button\" class=\"bg-[#0fffff] text-[#010b13] px-6 py-2.5 rounded-xl text-[10px] font-black tracking-widest uppercase transition-all hover:shadow-[0_0_20px_rgba(15,255,255,0.4)] hover:-translate-y-0.5 active:translate-y-0\" data-kid=\"67\">BROWSE FILES</button>\n                  </div>\n                </div>\n              </div>\n              \n              \n              <div class=\"flex items-center gap-6 px-5 py-3 bg-white/2 rounded-xl border border-white/5\" data-kid=\"68\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"69\">\n                  <i class=\"ti ti-clock-play text-[#0fffff] text-sm\" data-kid=\"70\"></i>\n                  <span class=\"text-[11px] text-white/50 uppercase tracking-widest font-bold\" data-kid=\"71\">Estimated: <strong class=\"text-white tracking-normal font-heading\" data-kid=\"72\">00:00</strong></span>\n                </div>\n                <div class=\"w-px h-3 bg-white/10\" data-kid=\"73\"></div>\n                <div class=\"flex items-center gap-2.5\" data-kid=\"74\">\n                  <i class=\"ti ti-credit-card text-[#bf00ff] text-sm\" data-kid=\"75\"></i>\n                  <span class=\"text-[11px] text-white/50 uppercase tracking-widest font-bold\" data-kid=\"76\">Billing: <strong class=\"text-white tracking-normal font-heading\" data-kid=\"77\">Rp0</strong></span>\n                </div>\n              </div>\n            </div>\n\n            \n            <div class=\"space-y-6\" data-kid=\"78\">\n              <div class=\"space-y-2.5\" data-kid=\"79\">\n                <label class=\"text-[10px] font-black text-white/40 uppercase tracking-[0.3em] px-1\" data-kid=\"80\">Job Contextual Title</label>\n                <div class=\"relative group\" data-kid=\"81\">\n                  <input type=\"text\" placeholder=\"Misal: Review Gadget Viral TikTok\" class=\"w-full bg-[#08131d] border border-white/10 rounded-xl px-5 py-3.5 text-sm font-medium focus:outline-none focus:border-[#0fffff]/50 focus:ring-1 focus:ring-[#0fffff]/20 focus:shadow-[0_0_15px_rgba(15,255,255,0.08)] transition-all placeholder:text-white/20\" data-kid=\"82\">\n                  <div class=\"absolute inset-y-0 right-4 flex items-center text-white/10 group-focus-within:text-[#0fffff]/40\" data-kid=\"83\">\n                    <i class=\"ti ti-edit\" data-kid=\"84\"></i>\n                  </div>\n                </div>\n              </div>\n  \n              <div class=\"space-y-2.5\" data-kid=\"85\">\n                <label class=\"text-[10px] font-black text-white/40 uppercase tracking-[0.3em] px-1\" data-kid=\"86\">Creative Brief / Narration Guideline</label>\n                <textarea rows=\"3\" placeholder=\"Tuliskan arahan utama, angle promosi, atau transkrip narasi yang diinginkan...\" class=\"w-full bg-[#08131d] border border-white/10 rounded-xl px-5 py-4 text-sm font-medium focus:outline-none focus:border-[#0fffff]/50 focus:ring-1 focus:ring-[#0fffff]/20 focus:shadow-[0_0_15px_rgba(15,255,255,0.08)] transition-all placeholder:text-white/20 resize-none leading-relaxed\" data-kid=\"87\"></textarea>\n              </div>\n\n              \n              <div class=\"grid grid-cols-2 gap-x-8 gap-y-6\" data-kid=\"88\">\n                <div class=\"space-y-2.5\" data-kid=\"89\">\n                  <label class=\"text-[10px] font-black text-white/40 uppercase tracking-[0.25em] px-1\" data-kid=\"90\">Content Taxonomy</label>\n                  <div class=\"relative\" data-kid=\"91\">\n                    <select class=\"w-full bg-[#08131d] border border-white/10 rounded-xl px-5 py-3.5 text-sm font-bold appearance-none focus:outline-none focus:border-[#0fffff]/50 transition-all text-white/80\" data-kid=\"92\">\n                      <option data-kid=\"93\">Affiliate Marketing</option>\n                      <option data-kid=\"94\">Direct Response Ads</option>\n                      <option data-kid=\"95\">Educational Content</option>\n                    </select>\n                    <div class=\"absolute inset-y-0 right-4 flex items-center pointer-events-none text-white/20\" data-kid=\"96\">\n                      <i class=\"ti ti-chevron-down\" data-kid=\"97\"></i>\n                    </div>\n                  </div>\n                </div>\n\n                <div class=\"space-y-2.5\" data-kid=\"98\">\n                  <label class=\"text-[10px] font-black text-white/40 uppercase tracking-[0.25em] px-1\" data-kid=\"99\">Vocal Identity</label>\n                  <div class=\"relative\" data-kid=\"100\">\n                    <select class=\"w-full bg-[#08131d] border border-white/10 rounded-xl px-5 py-3.5 text-sm font-bold appearance-none focus:outline-none focus:border-[#bf00ff]/50 transition-all text-white/80\" data-kid=\"101\">\n                      <option data-kid=\"102\">Natural Female</option>\n                      <option data-kid=\"103\">Professional Male</option>\n                      <option data-kid=\"104\">Energic Youngster</option>\n                    </select>\n                    <div class=\"absolute inset-y-0 right-4 flex items-center pointer-events-none text-white/20\" data-kid=\"105\">\n                      <i class=\"ti ti-gender-female\" data-kid=\"106\"></i>\n                    </div>\n                  </div>\n                </div>\n\n                <div class=\"space-y-2.5\" data-kid=\"107\">\n                  <label class=\"text-[10px] font-black text-white/40 uppercase tracking-[0.25em] px-1\" data-kid=\"108\">Synthesis Tone</label>\n                  <div class=\"relative\" data-kid=\"109\">\n                    <select class=\"w-full bg-[#08131d] border border-white/10 rounded-xl px-5 py-3.5 text-sm font-bold appearance-none focus:outline-none focus:border-[#0fffff]/50 transition-all text-white/80\" data-kid=\"110\">\n                      <option data-kid=\"111\">Natural & Flowy</option>\n                      <option data-kid=\"112\">Excited & High-Energy</option>\n                      <option data-kid=\"113\">Serious & Informative</option>\n                    </select>\n                    <div class=\"absolute inset-y-0 right-4 flex items-center pointer-events-none text-white/20\" data-kid=\"114\">\n                      <i class=\"ti ti-wave-sawtool\" data-kid=\"115\"></i>\n                    </div>\n                  </div>\n                </div>\n\n                <div class=\"space-y-2.5\" data-kid=\"116\">\n                  <label class=\"text-[10px] font-black text-white/40 uppercase tracking-[0.25em] px-1\" data-kid=\"117\">CTA Integration (Optional)</label>\n                  <div class=\"relative group\" data-kid=\"118\">\n                    <input type=\"text\" placeholder=\"Klik link di bio!\" class=\"w-full bg-[#08131d] border border-white/10 rounded-xl px-5 py-3.5 text-sm font-medium focus:outline-none focus:border-[#0fffff]/50 transition-all\" data-kid=\"119\">\n                    <div class=\"absolute inset-y-0 right-4 flex items-center text-white/10\" data-kid=\"120\">\n                      <i class=\"ti ti-link\" data-kid=\"121\"></i>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"space-y-2.5\" data-kid=\"122\">\n                <label class=\"text-[10px] font-black text-white/40 uppercase tracking-[0.25em] px-1\" data-kid=\"123\">External Reference Link (Opsional)</label>\n                <div class=\"relative group\" data-kid=\"124\">\n                  <input type=\"text\" placeholder=\"https://tiktok.com/viral-video-reference\" class=\"w-full bg-[#08131d] border border-white/10 rounded-xl px-5 py-3.5 text-sm font-medium focus:outline-none focus:border-[#0fffff]/50 transition-all\" data-kid=\"125\">\n                  <div class=\"absolute inset-y-0 right-4 flex items-center text-white/10\" data-kid=\"126\">\n                    <i class=\"ti ti-world\" data-kid=\"127\"></i>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            \n            <div class=\"h-32\" data-kid=\"128\"></div>\n          </form>\n        </div>\n      </main>\n\n      \n      <aside class=\"w-[30%] border-l border-white/10 bg-[#08131d]/20 backdrop-blur-sm p-8 overflow-y-auto custom-scrollbar\" data-kid=\"129\">\n        <div class=\"flex flex-col gap-6\" data-kid=\"130\">\n          <div class=\"flex items-center justify-between mb-2\" data-kid=\"131\">\n            <h3 class=\"text-[11px] font-black text-white/40 uppercase tracking-[0.4em]\" data-kid=\"132\">Operational Telemetry</h3>\n            <span class=\"flex items-center gap-2 text-[10px] text-[#0fffff] font-black tracking-widest uppercase\" data-kid=\"133\">\n              <span class=\"relative flex h-2 w-2\" data-kid=\"134\">\n                <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#0fffff] opacity-75\" data-kid=\"135\"></span>\n                <span class=\"relative inline-flex rounded-full h-2 w-2 bg-[#0fffff]\" data-kid=\"136\"></span>\n              </span>\n              Live\n            </span>\n          </div>\n\n          \n          <div class=\"bg-white/5 border border-white/10 rounded-2xl p-6 relative overflow-hidden group tech-card\" data-kid=\"137\">\n            <div class=\"absolute -top-4 -right-4 p-4 opacity-10 group-hover:opacity-20 transition-all duration-700 group-hover:rotate-12\" data-kid=\"138\">\n              <i class=\"ti ti-server-cog text-8xl\" data-kid=\"139\"></i>\n            </div>\n            <div class=\"relative z-10 space-y-6\" data-kid=\"140\">\n              <div class=\"flex justify-between items-start\" data-kid=\"141\">\n                <div data-kid=\"142\">\n                  <p class=\"text-[10px] text-white/40 font-black uppercase tracking-[0.25em] mb-1.5\" data-kid=\"143\">Compute Matrix</p>\n                  <h4 class=\"text-4xl font-heading font-black text-white tracking-tighter\" data-kid=\"144\">74<span class=\"text-sm text-[#0fffff] font-bold ml-1\" data-kid=\"145\">%</span></h4>\n                </div>\n                <span class=\"text-[9px] px-2.5 py-1 rounded-full bg-green-500/10 text-green-400 border border-green-500/20 font-black uppercase tracking-widest\" data-kid=\"146\">Optimized</span>\n              </div>\n              \n              <div class=\"space-y-3\" data-kid=\"147\">\n                <div class=\"flex justify-between text-[9px] font-black text-white/30 uppercase tracking-[0.15em]\" data-kid=\"148\">\n                  <span data-kid=\"149\">Utilization Load</span>\n                  <span class=\"text-white/60 font-heading\" data-kid=\"150\">3 / 4 NODE ACTIVE</span>\n                </div>\n                <div class=\"h-1.5 w-full bg-white/5 rounded-full overflow-hidden flex p-[1px] border border-white/5\" data-kid=\"151\">\n                  <div class=\"h-full bg-gradient-to-r from-[#0fffff] to-[#bf00ff] w-[75%] rounded-full shadow-[0_0_12px_rgba(15,255,255,0.4)]\" data-kid=\"152\"></div>\n                </div>\n              </div>\n              \n              <div class=\"flex items-center justify-between pt-3 border-t border-white/5\" data-kid=\"153\">\n                <div class=\"flex items-center gap-2 text-white/30\" data-kid=\"154\">\n                  <i class=\"ti ti-hourglass-low text-sm\" data-kid=\"155\"></i>\n                  <span class=\"text-[10px] font-bold tracking-tight\" data-kid=\"156\">Est. Wait: <span class=\"text-white/80\" data-kid=\"157\">4.5m</span></span>\n                </div>\n                <div class=\"flex items-center gap-2 text-white/30\" data-kid=\"158\">\n                  <i class=\"ti ti-cpu text-sm\" data-kid=\"159\"></i>\n                  <span class=\"text-[10px] font-bold tracking-tight\" data-kid=\"160\">Latency: <span class=\"text-white/80\" data-kid=\"161\">12ms</span></span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"grid grid-cols-1 gap-4\" data-kid=\"162\">\n            \n            <div class=\"bg-[#0fffff]/5 border border-[#0fffff]/10 rounded-2xl p-5 group hover:border-[#0fffff]/30 transition-all\" data-kid=\"163\">\n              <p class=\"text-[10px] text-white/40 font-bold uppercase tracking-widest mb-4\" data-kid=\"164\">Financial Status</p>\n              <div class=\"space-y-4\" data-kid=\"165\">\n                <div class=\"flex justify-between items-center\" data-kid=\"166\">\n                  <span class=\"text-xs text-white/50 font-medium\" data-kid=\"167\">Charge Estimation</span>\n                  <span class=\"text-base font-heading font-bold text-[#0fffff]\" data-kid=\"168\">Rp0</span>\n                </div>\n                <div class=\"h-px bg-white/5\" data-kid=\"169\"></div>\n                <div class=\"flex justify-between items-center\" data-kid=\"170\">\n                  <span class=\"text-xs text-white/50 font-medium\" data-kid=\"171\">Post-Job Liquidity</span>\n                  <span class=\"text-base font-heading font-bold text-white\" data-kid=\"172\">Rp452.800</span>\n                </div>\n              </div>\n            </div>\n\n            \n            <div class=\"bg-white/5 border border-white/10 rounded-2xl p-5 flex items-center gap-5\" data-kid=\"173\">\n              <div class=\"w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-[#bf00ff]\" data-kid=\"174\">\n                <i class=\"ti ti-layers-intersect text-2xl\" data-kid=\"175\"></i>\n              </div>\n              <div data-kid=\"176\">\n                <p class=\"text-[9px] text-white/40 font-bold uppercase tracking-widest\" data-kid=\"177\">Global Pipeline</p>\n                <h5 class=\"text-lg font-heading font-bold text-white\" data-kid=\"178\">18 Jobs <span class=\"text-[10px] text-white/20 font-medium tracking-normal ml-1\" data-kid=\"179\">in queue</span></h5>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"relative mt-2\" data-kid=\"180\">\n            <div class=\"absolute -inset-0.5 bg-gradient-to-r from-[#0fffff]/20 to-transparent rounded-2xl blur-xs\" data-kid=\"181\"></div>\n            <div class=\"relative bg-[#08131d] border border-white/10 p-5 rounded-2xl flex items-start gap-5 overflow-hidden group\" data-kid=\"182\">\n              <div class=\"absolute inset-y-0 left-0 w-[3px] bg-[#0fffff] shadow-[0_0_15px_rgba(15,255,255,0.5)]\" data-kid=\"183\"></div>\n              <div class=\"absolute top-0 right-0 w-16 h-16 bg-[#0fffff]/5 rounded-full blur-xl transition-all duration-700 group-hover:scale-150\" data-kid=\"184\"></div>\n              <div class=\"w-10 h-10 rounded-xl bg-[#0fffff]/10 flex items-center justify-center shrink-0 border border-[#0fffff]/20 text-[#0fffff] shadow-[inset_0_0_10px_rgba(15,255,255,0.1)]\" data-kid=\"185\">\n                <i class=\"ti ti-circle-check text-2xl\" data-kid=\"186\"></i>\n              </div>\n              <div class=\"space-y-1 relative z-10\" data-kid=\"187\">\n                <h5 class=\"text-[10px] font-black text-white uppercase tracking-[0.3em] mb-1\" data-kid=\"188\">Environment Ready</h5>\n                <p class=\"text-[11px] text-white/50 leading-relaxed font-medium italic\" data-kid=\"189\">Synthesis pipeline optimized. Critical engines are primed for high-fidelity vocal rendering protocols.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </aside>\n    </div>\n\n    \n    <div class=\"fixed bottom-10 left-[calc(72px+(70%-72px)/2)] -translate-x-1/2 z-[100] animate-float-up\" data-kid=\"190\">\n      <div class=\"bg-[#08131d]/90 backdrop-blur-3xl border border-white/10 rounded-[24px] p-2 flex items-center gap-2 shadow-[0_30px_70px_-10px_rgba(0,0,0,0.9)] neon-inset\" data-kid=\"191\">\n        \n        <button class=\"flex items-center gap-3 px-6 py-4 rounded-xl text-white/40 hover:text-[#0fffff] hover:bg-[#0fffff]/5 transition-all text-[10px] font-black uppercase tracking-[0.2em]\" data-kid=\"192\">\n          <i class=\"ti ti-history text-lg\" data-kid=\"193\"></i>\n          <span data-kid=\"194\">Riwayat Proses</span>\n        </button>\n        \n        <div class=\"w-[1px] h-6 bg-white/10 mx-1\" data-kid=\"195\"></div>\n        \n        \n        <button class=\"group relative flex items-center gap-3 px-12 py-4 rounded-xl bg-gradient-to-r from-[#0fffff] to-[#bf00ff] text-[#010b13] font-black text-[10px] uppercase tracking-[0.25em] transition-all hover:shadow-[0_0_40px_rgba(15,255,255,0.5)] active:scale-95 overflow-hidden\" data-kid=\"196\">\n          <div class=\"absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"197\"></div>\n          <i class=\"ti ti-sparkles text-lg animate-pulse\" data-kid=\"198\"></i>\n          <span data-kid=\"199\">Inisialisasi Job</span>\n          \n          \n          <div class=\"absolute -inset-full top-0 block transform -skew-x-20 bg-gradient-to-r from-transparent via-white/30 to-transparent opacity-30 transition-all duration-1000 group-hover:left-full\" data-kid=\"200\"></div>\n        </button>\n      </div>\n    </div>\n    \n  </div>\n</div>",
