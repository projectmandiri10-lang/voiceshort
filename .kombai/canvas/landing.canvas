      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --ink-black: #010B13;\n    --space-indigo: #1E2952;\n    --cyan-glow: #0FFFFF;\n    --hyper-magenta: #BF00FF;\n    --glass-bg: rgba(255, 255, 255, 0.04);\n    --glass-border: rgba(255, 255, 255, 0.1);\n  }\n\n  body {\n    background-color: var(--ink-black);\n    color: white;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-sora { font-family: 'Sora', sans-serif; }\n\n  .glass {\n    background: var(--glass-bg);\n    backdrop-filter: blur(24px);\n    border: 1px solid var(--glass-border);\n  }\n\n  .gradient-text {\n    background: linear-gradient(135deg, var(--cyan-glow), var(--hyper-magenta));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(120px);\n    z-index: -1;\n    pointer-events: none;\n    animation: drift 20s ease-in-out infinite alternate;\n  }\n\n  @keyframes drift {\n    0% { transform: translate(0, 0) scale(1); }\n    100% { transform: translate(30px, 30px) scale(1.1); }\n  }\n\n  /* Marquee Animation */\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  .marquee-content {\n    display: flex;\n    gap: 4rem;\n    animation: marquee 30s linear infinite;\n    width: max-content;\n  }\n\n  /* Premium Border for Pricing */\n  .premium-card-wrapper {\n    position: relative;\n    background: rgba(255, 255, 255, 0.08);\n  }\n\n  .premium-card-wrapper::before {\n    content: '';\n    position: absolute;\n    inset: -2px;\n    border-radius: 34px;\n    padding: 2px;\n    background: linear-gradient(135deg, var(--cyan-glow), var(--hyper-magenta));\n    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n    -webkit-mask-composite: xor;\n    mask-composite: exclude;\n    pointer-events: none;\n  }\n\n  .btn-glow-cyan:hover {\n    box-shadow: 0 0 30px rgba(15, 255, 255, 0.4);\n  }\n\n  .btn-glow-magenta:hover {\n    box-shadow: 0 0 30px rgba(191, 0, 255, 0.4);\n  }\n\n  .mask-edge {\n    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);\n  }\n</style>\n\n\n<div class=\"fixed inset-0 z-[-2] overflow-hidden pointer-events-none\" data-kid=\"1\">\n  <div class=\"orb bg-[var(--cyan-glow)] w-[600px] h-[600px] -top-20 -left-20 opacity-15\" data-kid=\"1-0\"></div>\n  <div class=\"orb bg-[var(--hyper-magenta)] w-[700px] h-[700px] top-[40%] -right-40 opacity-10\" data-kid=\"1-1\"></div>\n  <div class=\"orb bg-[var(--cyan-glow)] w-[500px] h-[500px] -bottom-20 left-1/3 opacity-10\" data-kid=\"1-2\"></div>\n</div>\n\n<main class=\"relative z-10\" data-kid=\"2\">\n  \n  <section class=\"min-h-[850px] flex items-center px-6 lg:px-20 py-20\" data-kid=\"2-0\">\n    <div class=\"container mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16 items-center\" data-kid=\"2-0-0\">\n      \n      \n      <div class=\"lg:col-span-7 relative group py-12\" data-kid=\"2-0-0-0\">\n        <div class=\"absolute -inset-10 bg-[var(--cyan-glow)]/5 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"2-0-0-0-0\"></div>\n        \n        <div class=\"relative z-10 space-y-10\" data-kid=\"2-0-0-0-1\">\n          <div class=\"inline-flex items-center gap-3 px-5 py-2 rounded-full glass border border-white/20 text-xs font-bold uppercase tracking-[0.2em] text-[var(--cyan-glow)]\" data-kid=\"2-0-0-0-1-0\">\n            <span class=\"relative flex h-2 w-2\" data-kid=\"2-0-0-0-1-0-0\">\n              <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--cyan-glow)] opacity-75\" data-kid=\"2-0-0-0-1-0-0-0\"></span>\n              <span class=\"relative inline-flex rounded-full h-2 w-2 bg-[var(--cyan-glow)]\" data-kid=\"2-0-0-0-1-0-0-1\"></span>\n            </span>\n            Voiceshort AI v2.0\n          </div>\n          \n          <h1 class=\"font-sora text-5xl lg:text-6xl xl:text-7xl font-extrabold leading-[1.1] tracking-tight\" data-kid=\"2-0-0-0-1-1\">\n            Bikin voice over <span class=\"block\" data-kid=\"2-0-0-0-1-1-0\">video pendek</span> <span class=\"gradient-text\" data-kid=\"2-0-0-0-1-1-1\">lebih cepat</span> dan lebih rapi.\n          </h1>\n          \n          <p class=\"text-xl text-white/50 max-w-xl leading-relaxed\" data-kid=\"2-0-0-0-1-2\">\n            Unggah video, tulis arahan singkat, lalu Voiceshort membantu menyiapkan narasi untuk konten Anda. Cocok untuk creator, jualan online, dan video promosi harian.\n          </p>\n          \n          <div class=\"flex flex-wrap gap-5 pt-4\" data-kid=\"2-0-0-0-1-3\">\n            <a href=\"#pricing\" class=\"px-10 py-5 rounded-2xl bg-[var(--cyan-glow)] text-[var(--ink-black)] font-extrabold text-lg btn-glow-cyan transition-all transform hover:scale-[1.02]\" data-kid=\"2-0-0-0-1-3-0\">\n              Lihat Paket Saldo\n            </a>\n            <a href=\"#legal\" class=\"px-10 py-5 rounded-2xl glass text-white font-bold text-lg hover:bg-white/10 transition-all border border-white/20\" data-kid=\"2-0-0-0-1-3-1\">\n              Kebijakan Layanan\n            </a>\n          </div>\n\n          \n          <div class=\"mt-16 w-full max-w-2xl h-48 rounded-[40px] overflow-hidden glass relative border border-white/5 opacity-60\" data-kid=\"2-0-0-0-1-4\">\n             <video src=\"https://videos.pexels.com/video-files/34645278/14683992_640_360_30fps.mp4\" poster=\"https://images.pexels.com/videos/34645278/abstract-wave-acoustic-audio-audio-frequency-34645278.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline class=\"w-full h-full object-cover grayscale opacity-50 contrast-125\" data-kid=\"2-0-0-0-1-4-0\"></video>\n             <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--ink-black)] to-transparent\" data-kid=\"2-0-0-0-1-4-1\"></div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-5\" data-kid=\"2-0-0-1\">\n        <div class=\"glass p-10 rounded-[40px] border border-white/10 shadow-3xl relative overflow-hidden\" data-kid=\"2-0-0-1-0\">\n          <div class=\"absolute -top-20 -right-20 w-64 h-64 bg-[var(--cyan-glow)]/10 blur-[100px]\" data-kid=\"2-0-0-1-0-0\"></div>\n          \n          <div class=\"flex items-center gap-2 mb-10 bg-white/5 p-1.5 rounded-2xl border border-white/5\" data-kid=\"2-0-0-1-0-1\">\n            <button class=\"flex-1 py-4 px-6 rounded-xl bg-white/10 text-white font-bold text-sm shadow-inner transition-all\" data-kid=\"2-0-0-1-0-1-0\">Masuk</button>\n            <button class=\"flex-1 py-4 px-6 rounded-xl text-white/40 font-bold text-sm hover:text-white transition-colors\" data-kid=\"2-0-0-1-0-1-1\">Daftar Akun</button>\n          </div>\n\n          <div class=\"space-y-8\" data-kid=\"2-0-0-1-0-2\">\n            <div class=\"text-center space-y-2\" data-kid=\"2-0-0-1-0-2-0\">\n              <h2 class=\"font-sora text-3xl font-extrabold\" data-kid=\"2-0-0-1-0-2-0-0\">Mulai Sekarang</h2>\n              <p class=\"text-white/40 text-sm\" data-kid=\"2-0-0-1-0-2-0-1\">Gunakan Google untuk akses instan tanpa password.</p>\n            </div>\n\n            <button class=\"w-full flex items-center justify-center gap-4 py-5 rounded-2xl bg-white text-[var(--ink-black)] font-black text-lg hover:bg-gray-100 transition-all shadow-[0_20px_40px_rgba(255,255,255,0.1)] border-b-4 border-gray-200 active:translate-y-1 active:border-b-0\" data-kid=\"2-0-0-1-0-2-1\">\n              <svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" data-kid=\"2-0-0-1-0-2-1-0\">\n                <path d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" fill=\"#4285F4\" data-kid=\"2-0-0-1-0-2-1-0-0\"></path>\n                <path d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" fill=\"#34A853\" data-kid=\"2-0-0-1-0-2-1-0-1\"></path>\n                <path d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\" fill=\"#FBBC05\" data-kid=\"2-0-0-1-0-2-1-0-2\"></path>\n                <path d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\" fill=\"#EA4335\" data-kid=\"2-0-0-1-0-2-1-0-3\"></path>\n              </svg>\n              Masuk dengan Google\n            </button>\n\n            <div class=\"flex items-center gap-6\" data-kid=\"2-0-0-1-0-2-2\">\n              <div class=\"flex-1 h-px bg-white/10\" data-kid=\"2-0-0-1-0-2-2-0\"></div>\n              <span class=\"text-white/40 text-[10px] font-black uppercase tracking-[0.3em]\" data-kid=\"2-0-0-1-0-2-2-1\">Atau Lanjut Email</span>\n              <div class=\"flex-1 h-px bg-white/10\" data-kid=\"2-0-0-1-0-2-2-2\"></div>\n            </div>\n\n            <form class=\"space-y-5\" data-kid=\"2-0-0-1-0-2-3\">\n              <div class=\"space-y-3\" data-kid=\"2-0-0-1-0-2-3-0\">\n                <label class=\"text-[10px] font-black text-white/30 uppercase tracking-widest ml-1\" data-kid=\"2-0-0-1-0-2-3-0-0\">Email Address</label>\n                <input type=\"email\" placeholder=\"nama@email.com\" class=\"w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 focus:outline-none focus:border-[var(--cyan-glow)]/50 focus:ring-1 focus:ring-[var(--cyan-glow)]/50 transition-all text-sm placeholder:text-white/20\" data-kid=\"2-0-0-1-0-2-3-0-1\">\n              </div>\n              <div class=\"space-y-3\" data-kid=\"2-0-0-1-0-2-3-1\">\n                <label class=\"text-[10px] font-black text-white/30 uppercase tracking-widest ml-1\" data-kid=\"2-0-0-1-0-2-3-1-0\">Secure Password</label>\n                <input type=\"password\" placeholder=\"Minimal 8 karakter\" class=\"w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 focus:outline-none focus:border-[var(--cyan-glow)]/50 focus:ring-1 focus:ring-[var(--cyan-glow)]/50 transition-all text-sm placeholder:text-white/20\" data-kid=\"2-0-0-1-0-2-3-1-1\">\n              </div>\n              <button class=\"w-full py-5 rounded-2xl bg-[var(--hyper-magenta)] text-white font-black text-lg btn-glow-magenta transition-all shadow-xl shadow-magenta-500/10\" data-kid=\"2-0-0-1-0-2-3-2\">\n                Masuk\n              </button>\n            </form>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-16 glass border-y border-white/5 overflow-hidden\" data-kid=\"2-1\">\n    <div class=\"container mx-auto px-6 mb-8 text-center\" data-kid=\"2-1-0\">\n      <p class=\"text-white/30 text-xs font-bold uppercase tracking-[0.4em]\" data-kid=\"2-1-0-0\">Optimal Untuk Berbagai Platform</p>\n    </div>\n    <div class=\"mask-edge\" data-kid=\"2-1-1\">\n      <div class=\"marquee-content py-4\" data-kid=\"2-1-1-0\">\n        \n        <div class=\"flex items-center gap-3 px-8 py-3 glass rounded-2xl border border-white/5 grayscale opacity-40 hover:grayscale-0 hover:opacity-100 transition-all\" data-kid=\"2-1-1-0-0\">\n          <i class=\"ti ti-brand-tiktok text-2xl\" data-kid=\"2-1-1-0-0-0\"></i>\n          <span class=\"font-bold tracking-tight\" data-kid=\"2-1-1-0-0-1\">TikTok</span>\n        </div>\n        <div class=\"flex items-center gap-3 px-8 py-3 glass rounded-2xl border border-white/5 grayscale opacity-40 hover:grayscale-0 hover:opacity-100 transition-all\" data-kid=\"2-1-1-0-1\">\n          <i class=\"ti ti-brand-instagram text-2xl\" data-kid=\"2-1-1-0-1-0\"></i>\n          <span class=\"font-bold tracking-tight\" data-kid=\"2-1-1-0-1-1\">Inst