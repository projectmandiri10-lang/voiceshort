      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --ink-black: #010B13;\n    --space-indigo: #1E2952;\n    --cyan-glow: #0FFFFF;\n    --hyper-magenta: #BF00FF;\n    --glass-bg: rgba(255, 255, 255, 0.04);\n    --glass-border: rgba(255, 255, 255, 0.1);\n  }\n\n  body {\n    background-color: var(--ink-black);\n    color: white;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-sora { font-family: 'Sora', sans-serif; }\n  .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n  .glass {\n    background: var(--glass-bg);\n    backdrop-filter: blur(24px);\n    border: 1px solid var(--glass-border);\n  }\n\n  .gradient-text {\n    background: linear-gradient(135deg, var(--cyan-glow), var(--hyper-magenta));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(120px);\n    z-index: -1;\n    pointer-events: none;\n    animation: drift 20s ease-in-out infinite alternate;\n  }\n\n  @keyframes drift {\n    0% { transform: translate(0, 0) scale(1); }\n    100% { transform: translate(30px, 30px) scale(1.1); }\n  }\n\n  /* Custom Glows */\n  .glow-cyan { text-shadow: 0 0 15px rgba(15, 255, 255, 0.5); }\n  .glow-box-cyan { box-shadow: 0 0 20px rgba(15, 255, 255, 0.2); }\n  .glow-box-magenta { box-shadow: 0 0 20px rgba(191, 0, 255, 0.2); }\n\n  /* Cockpit Elements */\n  .cockpit-card {\n    background: linear-gradient(165deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);\n    backdrop-filter: blur(32px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    position: relative;\n    overflow: hidden;\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n  \n  .cockpit-card::after {\n    content: '';\n    position: absolute;\n    top: 0; right: 0;\n    width: 40px; height: 40px;\n    background: linear-gradient(135deg, transparent 50%, rgba(15, 255, 255, 0.08) 50%);\n    pointer-events: none;\n    border-bottom-left-radius: 20px;\n  }\n\n  .cockpit-card:hover {\n    border-color: rgba(15, 255, 255, 0.25);\n    box-shadow: inset 0 0 30px rgba(15, 255, 255, 0.04), 0 20px 40px rgba(0, 0, 0, 0.4);\n    transform: translateY(-2px);\n  }\n\n  .neon-input {\n    background: rgba(1, 11, 19, 0.4);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    transition: all 0.3s ease;\n    backdrop-filter: blur(4px);\n  }\n\n  .neon-input:focus {\n    outline: none;\n    border-color: var(--cyan-glow);\n    box-shadow: 0 0 15px rgba(15, 255, 255, 0.15), inset 0 0 8px rgba(15, 255, 255, 0.05);\n    background: rgba(1, 11, 19, 0.6);\n  }\n\n  .monitor-banner {\n    background: linear-gradient(90deg, rgba(30, 41, 82, 0.4) 0%, rgba(1, 11, 19, 0.4) 100%);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(15, 255, 255, 0.1);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .monitor-banner::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background-image: radial-gradient(circle at 2px 2px, rgba(255, 255, 255, 0.03) 1px, transparent 0);\n    background-size: 10px 10px;\n    opacity: 0.5;\n  }\n\n  .scanline {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%; height: 2px;\n    background: linear-gradient(to right, transparent, var(--cyan-glow), transparent);\n    opacity: 0.05;\n    animation: scan 10s linear infinite;\n  }\n\n  @keyframes scan {\n    0% { transform: translateY(-100%); }\n    100% { transform: translateY(1000px); }\n  }\n\n  /* Scrollbar */\n  ::-webkit-scrollbar { width: 6px; }\n  ::-webkit-scrollbar-track { background: transparent; }\n  ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }\n\n  .btn-gradient-cyan {\n    background: linear-gradient(135deg, var(--cyan-glow), #00D1D1);\n    color: var(--ink-black);\n    box-shadow: 0 0 25px rgba(15, 255, 255, 0.3);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .btn-gradient-cyan::before {\n    content: '';\n    position: absolute;\n    top: 0; left: -100%;\n    width: 50%; height: 100%;\n    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);\n    transform: skewX(-25deg);\n    animation: shine 3s infinite;\n  }\n\n  @keyframes shine {\n    0% { left: -100%; }\n    20% { left: 150%; }\n    100% { left: 150%; }\n  }\n\n  .btn-gradient-magenta {\n    background: linear-gradient(135deg, var(--hyper-magenta), #8000FF);\n    color: white;\n    box-shadow: 0 0 20px rgba(191, 0, 255, 0.2);\n  }\n</style>\n\n<div class=\"fixed inset-0 z-[-2] overflow-hidden pointer-events-none\" data-kid=\"1\">\n  <div class=\"orb bg-[var(--cyan-glow)] w-[600px] h-[600px] -top-20 -left-20 opacity-10\" data-kid=\"1-0\"></div>\n  <div class=\"orb bg-[var(--hyper-magenta)] w-[700px] h-[700px] top-[40%] -right-40 opacity-5\" data-kid=\"1-1\"></div>\n  <div class=\"orb bg-[var(--cyan-glow)] w-[500px] h-[500px] -bottom-20 left-1/3 opacity-5\" data-kid=\"1-2\"></div>\n</div>\n\n<div class=\"flex min-h-screen\" data-kid=\"2\">\n  \n  <aside class=\"w-72 border-r border-white/5 glass flex flex-col shrink-0\" data-kid=\"2-0\">\n    <div class=\"p-10 flex items-center gap-3\" data-kid=\"2-0-0\">\n      <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-[var(--cyan-glow)] to-[var(--hyper-magenta)] flex items-center justify-center font-black text-[var(--ink-black)] text-xl\" data-kid=\"2-0-0-0\">V</div>\n      <span class=\"font-sora font-extrabold text-2xl tracking-tight\" data-kid=\"2-0-0-1\">Voiceshort</span>\n    </div>\n    \n    <nav class=\"flex-1 px-6 space-y-3 mt-4\" data-kid=\"2-0-1\">\n      <div class=\"text-[10px] font-black text-white/20 uppercase tracking-[0.3em] mb-6 px-4\" data-kid=\"2-0-1-0\">Management</div>\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 rounded-2xl bg-white/5 text-[var(--cyan-glow)] font-bold border border-[var(--cyan-glow)]/20 shadow-[0_0_25px_rgba(15,255,255,0.05)]\" data-kid=\"2-0-1-1\">\n        <i class=\"ti ti-wand text-xl\" data-kid=\"2-0-1-1-0\"></i> Generate\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 rounded-2xl text-white/40 hover:text-white transition-all hover:bg-white/5 group\" data-kid=\"2-0-1-2\">\n        <i class=\"ti ti-history text-xl group-hover:text-[var(--hyper-magenta)] transition-colors\" data-kid=\"2-0-1-2-0\"></i> History\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 rounded-2xl text-white/40 hover:text-white transition-all hover:bg-white/5 group\" data-kid=\"2-0-1-3\">\n        <i class=\"ti ti-wallet text-xl group-hover:text-[var(--cyan-glow)] transition-colors\" data-kid=\"2-0-1-3-0\"></i> Wallet\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-4 px-5 py-4 rounded-2xl text-white/40 hover:text-white transition-all hover:bg-white/5 group\" data-kid=\"2-0-1-4\">\n        <i class=\"ti ti-settings text-xl group-hover:rotate-45 transition-all\" data-kid=\"2-0-1-4-0\"></i> Settings\n      </a>\n    </nav>\n\n    <div class=\"p-8 border-t border-white/5\" data-kid=\"2-0-2\">\n      <div class=\"glass p-5 rounded-2xl border-white/10 space-y-4\" data-kid=\"2-0-2-0\">\n        <div class=\"flex items-center gap-3\" data-kid=\"2-0-2-0-0\">\n          <div class=\"w-2 h-2 rounded-full bg-[var(--cyan-glow)] animate-pulse\" data-kid=\"2-0-2-0-0-0\"></div>\n          <span class=\"text-[10px] font-bold text-white/40 uppercase tracking-widest\" data-kid=\"2-0-2-0-0-1\">Server Status</span>\n        </div>\n        <p class=\"text-xs text-white/60 leading-relaxed\" data-kid=\"2-0-2-0-1\">System is running at optimal capacity.</p>\n      