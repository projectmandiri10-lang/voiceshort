      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  * {\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\n\n  body {\n    background-color: #010B13;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    color: white;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .aurora-orb {\n    filter: blur(100px);\n    border-radius: 50%;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.04);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .neon-glow-cyan {\n    box-shadow: 0 0 20px rgba(15, 255, 255, 0.15), inset 0 0 30px rgba(15, 255, 255, 0.03);\n  }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-100%); }\n  }\n\n  .animate-marquee {\n    animation: marquee 30s linear infinite;\n  }\n\n  /* Custom input focus states */\n  input:focus {\n    outline: none;\n    border-color: rgba(15, 255, 255, 0.4);\n    box-shadow: 0 0 10px rgba(15, 255, 255, 0.1);\n  }\n</style>\n\n<div class=\"relative w-[375px] bg-[#010B13] overflow-x-hidden\" data-kid=\"1\">\n  \n  <nav class=\"relative z-50 px-6 py-6 flex justify-between items-center\" data-kid=\"1-0\">\n    <div class=\"flex items-center gap-1\" data-kid=\"1-0-0\">\n      <div class=\"w-8 h-8 rounded-lg bg-gradient-to-br from-[#0FFFFF] to-[#BF00FF] flex items-center justify-center p-[1px]\" data-kid=\"1-0-0-0\">\n        <div class=\"w-full h-full bg-[#010B13] rounded-[7px] flex items-center justify-center\" data-kid=\"1-0-0-0-0\">\n          <i class=\"ti ti-microphone text-white text-lg\" data-kid=\"1-0-0-0-0-0\"></i>\n        </div>\n      </div>\n      <span class=\"font-black text-xl tracking-tighter italic\" data-kid=\"1-0-0-1\">VOICESHORT<span class=\"text-[#0FFFFF]\" data-kid=\"1-0-0-1-0\">.</span></span>\n    </div>\n    <button class=\"w-10 h-10 rounded-xl glass-card flex items-center justify-center text-white/80\" data-kid=\"1-0-1\">\n      <i class=\"ti ti-menu-2 text-xl\" data-kid=\"1-0-1-0\"></i>\n    </button>\n  </nav>\n\n  \n  <section class=\"relative px-6 pt-10 pb-20\" data-kid=\"1-1\">\n    \n    <div class=\"absolute -top-10 -left-20 w-64 h-64 bg-[#0FFFFF]/15 aurora-orb\" data-kid=\"1-1-0\"></div>\n    <div class=\"absolute top-40 -right-20 w-80 h-80 bg-[#BF00FF]/10 aurora-orb\" data-kid=\"1-1-1\"></div>\n    \n    <div class=\"relative z-10 text-center space-y-6\" data-kid=\"1-1-2\">\n      <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold text-[#0FFFFF] uppercase tracking-widest\" data-kid=\"1-1-2-0\">\n        <span class=\"w-1 h-1 rounded-full bg-[#0FFFFF] animate-pulse\" data-kid=\"1-1-2-0-0\"></span>\n        AI-Powered Production\n      </div>\n      \n      <h1 class=\"text-[42px] font-extrabold leading-[1.05] tracking-tight bg-gradient-to-b from-white to-white/50 bg-clip-text text-transparent px-2\" data-kid=\"1-1-2-1\">\n        Bikin voice over video pendek lebih cepat & rapi.\n      </h1>\n      \n      <p class=\"text-white/50 text-sm leading-relaxed px-6\" data-kid=\"1-1-2-2\">\n        Unggah video, tulis arahan singkat, lalu Voiceshort membantu menyiapkan narasi profesional untuk konten Anda.\n      </p>\n\n      \n      <div class=\"mt-12\" data-kid=\"1-1-2-3\">\n        <div class=\"glass-card rounded-[32px] p-7 text-left shadow-2xl relative overflow-hidden\" data-kid=\"1-1-2-3-0\">\n          <div class=\"absolute -top-10 -right-10 w-32 h-32 bg-[#0FFFFF]/10 blur-3xl rounded-full\" data-kid=\"1-1-2-3-0-0\"></div>\n          \n          <div class=\"relative z-10\" data-kid=\"1-1-2-3-0-1\">\n            <h2 class=\"text-xl font-bold mb-1 tracking-tight\" data-kid=\"1-1-2-3-0-1-0\">Mulai Sekarang</h2>\n            <p class=\"text-white/30 text-xs mb-8\" data-kid=\"1-1-2-3-0-1-1\">Gunakan akun Google untuk masuk instan.</p>\n            \n            <button class=\"w-full flex items-center justify-center gap-3 py-4 bg-[#010B13] border border-[#0FFFFF]/40 rounded-xl shadow-[0_0_20px_rgba(15,255,255,0.08)] mb-6 active:scale-95 transition-transform\" data-kid=\"1-1-2-3-0-1-2\">\n              <div class=\"w-5 h-5 bg-white rounded-full flex items-center justify-center\" data-kid=\"1-1-2-3-0-1-2-0\">\n                <svg viewBox=\"0 0 24 24\" class=\"w-3 h-3\" data-kid=\"1-1-2-3-0-1-2-0-0\"><path fill=\"#010B13\" d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" data-kid=\"1-1-2-3-0-1-2-0-0-0\"></path><path fill=\"#010B13\" d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" data-kid=\"1-1-2-3-0-1-2-0-0-1\"></path><path fill=\"#010B13\" d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z\" data-kid=\"1-1-2-3-0-1-2-0-0-2\"></path><path fill=\"#010B13\" d=\"M12 5.38c1.62 0 3.06.56 4.21 1.66l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\" data-kid=\"1-1-2-3-0-1-2-0-0-3\"></path></svg>\n              </div>\n              <span class=\"text-sm font-bold text-[#0FFFFF] uppercase tracking-widest\" data-kid=\"1-1-2-3-0-1-2-1\">Sign in with Google</span>\n            </button>\n\n            <div class=\"flex items-center gap-4 mb-8\" data-kid=\"1-1-2-3-0-1-3\">\n              <div class=\"h-px grow bg-white/10\" data-kid=\"1-1-2-3-0-1-3-0\"></div>\n              <span class=\"text-[9px] font-black text-white/20 uppercase tracking-[0.2em] whitespace-nowrap\" data-kid=\"1-1-2-3-0-1-3-1\">Atau gunakan email</span>\n              <div class=\"h-px grow bg-white/10\" data-kid=\"1-1-2-3-0-1-3-2\"></div>\n            </div>\n\n            <div class=\"space-y-4\" data-kid=\"1-1-2-3-0-1-4\">\n              <div data-kid=\"1-1-2-3-0-1-4-0\">\n                <label class=\"block text-[11px] font-bold text-white/40 uppercase mb-2 ml-1 tracking-widest\" data-kid=\"1-1-2-3-0-1-4-0-0\">Email Address</label>\n                <input type=\"email\" placeholder=\"nama@email.com\" class=\"w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3.5 text-sm transition-all focus:bg-white/[0.1] focus:border-[#0FFFFF]/30\" data-kid=\"1-1-2-3-0-1-4-0-1\">\n              </div>\n              <div data-kid=\"1-1-2-3-0-1-4-1\">\n                <label class=\"block text-[11px] font-bold text-white/40 uppercase mb-2 ml-1 tracking-widest\" data-kid=\"1-1-2-3-0-1-4-1-0\">Password</label>\n                <input type=\"password\" placeholder=\"Minimal 8 karakter\" class=\"w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3.5 text-sm transition-all focus:bg-white/[0.1] focus:border-[#0FFFFF]/30\" data-kid=\"1-1-2-3-0-1-4-1-1\">\n              </div>\n              <button class=\"w-full py-4 mt-2 bg-white text-[#010B13] font-black rounded-xl text-sm shadow-[0_15px_30px_rgba(255,255,255,0.1)] active:scale-95 transition-transform uppercase tracking-widest\" data-kid=\"1-1-2-3-0-1-4-2\">\n                Masuk Akun\n              </button>\n            </div>\n            \n            <div class=\"mt-6 text-center\" data-kid=\"1-1-2-3-0-1-5\">\n              <p class=\"text-white/20 text-[10px] font-medium\" data-kid=\"1-1-2-3-0-1-5-0\">Belum punya akun? <span class=\"text-[#0FFFFF] font-bold\" data-kid=\"1-1-2-3-0-1-5-0-0\">Daftar Gratis</span></p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-14 border-y border-white/[0.08] bg-white/[0.02]\" data-kid=\"1-2\">\n    <div class=\"absolute inset-0 bg-gradient-to-r from-[#010B13] via-transparent to-[#010B13] z-10 pointer-events-none\" data-kid=\"1-2-0\"></div>\n    <div class=\"overflow-hidden flex gap-16 select-none\" data-kid=\"1-2-1\">\n      <div class=\"flex shrink-0 items-center justify-around gap-20 min-w-full animate-marquee\" data-kid=\"1-2-1-0\">\n        <span class=\"text-2xl font-black text-white/25 tracking-tighter flex items-center gap-3 group transition-colors hover:text-white/50\" data-kid=\"1-2-1-0-0\"><i class=\"ti ti-brand-tiktok text-3xl text-[#0FFFFF]\" data-kid=\"1-2-1-0-0-0\"></i> TikTok</span>\n        <span class=\"text-2xl font-black text-white/25 tracking-tighter flex items-center gap-3 group transition-colors hover:text-white/50\" data-kid=\"1-2-1-0-1\"><i class=\"ti ti-brand-instagram text-3xl text-[#BF00FF]\" data-kid=\"1-2-1-0-1-0\"></i> Reels</span>\n        <span class=\"text-2xl font-black text-white/25 tracking-tighter flex items-center gap-3 group transition-colors hover:text-white/50\" data-kid=\"1-2-1-0-2\"><i class=\"ti ti-brand-youtube text-3xl text-[#0FFFFF]\" data-kid=\"1-2-1-0-2-0\"></i> Shorts</span>\n        <span class=\"text-2xl font-black text-white/25 tracking-tighter flex items-center gap-3 group transition-colors hover:text-white/50\" data-kid=\"1-2-1-0-3\"><i class=\"ti ti-brand-facebook text-3xl text-[#BF00FF]\" data-kid=\"1-2-1-0-3-0\"></i> Video</span>\n      </div>\n      <div class=\"flex shrink-0 items-center justify-around gap-20 min-w-full animate-marquee\" data-kid=\"1-2-1-1\">\n        <span class=\"text-2xl font-black text-white/25 tracking-tighter flex items-center gap-3 group transition-colors hover:text-white/50\" data-kid=\"1-2-1-1-0\"><i class=\"ti ti-brand-tiktok text-3xl text-[#0FFFFF]\" data-kid=\"1-2-1-1-0-0\"></i> TikTok</span>\n        <span class=\"text-2xl font-black text-white/25 tracking-tighter flex items-center gap-3 group transition-colors hover:text-white/50\" data-kid=\"1-2-1-1-1\"><i class=\"ti ti-brand-instagram text-3xl text-[#BF00FF]\" data-kid=\"1-2-1-1-1-0\"></i> Reels</span>\n        <span class=\"text-2xl font-black text-white/25 tracking-tighter flex items-center gap-3 group transition-colors hover:text-white/50\" data-kid=\"1-2-1-1-2\"><i class=\"ti ti-brand-youtube text-3xl text-[#0FFFFF]\" data-kid=\"1-2-1-1-2-0\"></i> Shorts</span>\n        <span class=\"text-2xl font-black text-white/25 tracking-tighter flex items-center gap-3 group transition-colors hover:text-white/50\" data-kid=\"1-2-1-1-3\"><i class=\"ti ti-brand-facebook text-3xl text-[#BF00FF]\" data-kid=\"1-2-1-1-3-0\"></i> Video</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-6 py-24 space-y-16\" data-kid=\"1-3\">\n    <div class=\"text-center space-y-3\" data-kid=\"1-3-0\">\n      <span class=\"text-[#BF00FF] text-[10px] font-black uppercase tracking-[0.3em]\" data-kid=\"1-3-0-0\">Capabilities</span>\n      <h2 class=\"text-3xl font-extrabold tracking-tight\" data-kid=\"1-3-0-1\">Teknologi Terkini</h2>\n    </div>\n    \n    <div class=\"space-y-6\" data-kid=\"1-3-1\">\n      <div class=\"rounded-[32px] border border-white/10 bg-[#1E2952]/30 overflow-hidden relative group\" data-kid=\"1-3-1-0\">\n        <div class=\"p-8 pb-0\" data-kid=\"1-3-1-0-0\">\n          <div class=\"w-12 h-12 rounded-2xl bg-[#0FFFFF]/10 border border-[#0FFFFF]/20 flex items-center justify-center text-[#0FFFFF] mb-6\" data-kid=\"1-3-1-0-0-0\">\n            <i class=\"ti ti-bolt text-2xl\" data-kid=\"1-3-1-0-0-0-0\"></i>\n          </div>\n          <h3 class=\"text-2xl font-bold mb-3 tracking-tight\" data-kid=\"1-3-1-0-0-1\">Narasi Siap Pakai</h3>\n          <p class=\"text-white/40 text-sm leading-relaxed mb-8\" data-kid=\"1-3-1-0-0-2\">Ubah video mentah menjadi voice over berbahasa Indonesia yang lebih rapi dan siap diposting.</p>\n        </div>\n        <div class=\"relative h-56 mt-4\" data-kid=\"1-3-1-0-1\">\n          <img src=\"https://images.unsplash.com/photo-1648291308119-ec5a5df0bed8?auto=format&w=800&q=80&fit=crop\" alt=\"Abstract Prism\" class=\"w-full h-full object-cover\" data-kid=\"1-3-1-0-1-0\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-[#010B13] via-[#010B13]/40 to-transparent\" data-kid=\"1-3-1-0-1-1\"></div>\n          <div class=\"absolute bottom-6 left-6 right-6 p-4 glass-card rounded-xl border-white/20 flex items-center gap-3\" data-kid=\"1-3-1-0-1-2\">\n            <div class=\"w-2 h-2 rounded-full bg-[#0FFFFF] animate-ping\" data-kid=\"1-3-1-0-1-2-0\"></div>\n            <div class=\"h-1 grow bg-white/10 rounded-full overflow-hidden\" data-kid=\"1-3-1-0-1-2-1\">\n              <div class=\"h-full bg-gradient-to-r from-[#0FFFFF] to-[#BF00FF] w-[70%]\" data-kid=\"1-3-1-0-1-2-1-0\"></div>\n            </div>\n            <span class=\"text-[10px] font-bold text-white/60\" data-kid=\"1-3-1-0-1-2-2\">Processing...</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"rounded-[32px] border border-white/10 bg-white/[0.03] p-8 relative overflow-hidden group\" data-kid=\"1-3-1-1\">\n        <div class=\"absolute -right-6 -bottom-6 w-32 h-32 bg-[#BF00FF]/10 blur-3xl transition-all duration-500 group-hover:scale-150\" data-kid=\"1-3-1-1-0\"></div>\n        <div class=\"w-12 h-12 rounded-2xl bg-[#BF00FF]/10 border border-[#BF00FF]/20 flex items-center justify-center text-[#BF00FF] mb-6\" data-kid=\"1-3-1-1-1\">\n          <i class=\"ti ti-activity text-2xl\" data-kid=\"1-3-1-1-1-0\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold mb-3\" data-kid=\"1-3-1-1-2\">Cepat dan Praktis</h3>\n        <p class=\"text-white/40 text-sm leading-relaxed\" data-kid=\"1-3-1-1-3\">Cukup unggah video, isi arahan singkat, lalu sistem memprosesnya tanpa ribet.</p>\n      </div>\n\n      <div class=\"rounded-[32px] border border-white/10 bg-white/[0.03] p-8 relative overflow-hidden group\" data-kid=\"1-3-1-2\">\n        <div class=\"absolute -right-6 -bottom-6 w-32 h-32 bg-cyan-500/10 blur-3xl transition-all duration-500 group-hover:scale-150\" data-kid=\"1-3-1-2-0\"></div>\n        <div class=\"w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-6\" data-kid=\"1-3-1-2-1\">\n          <i class=\"ti ti-video text-2xl\" data-kid=\"1-3-1-2-1-0\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold mb-3\" data-kid=\"1-3-1-2-2\">Pantau Hasilnya</h3>\n        <p class=\"text-white/40 text-sm leading-relaxed\" data-kid=\"1-3-1-2-3\">Lihat perkembangan proses dan unduh hasil begitu voice over selesai dibuat.</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"pricing\" class=\"relative px-6 py-24 bg-white/[0.02]\" data-kid=\"1-4\">\n    <div class=\"text-center space-y-4 mb-20\" data-kid=\"1-4-0\">\n      <span class=\"text-[#0FFFFF] text-[10px] font-black uppercase tracking-[0.4em]\" data-kid=\"1-4-0-0\">Paket Saldo</span>\n      <h2 class=\"text-4xl font-extrabold tracking-tight\" data-kid=\"1-4-0-1\">Pilih Saldo Anda.</h2>\n      <p class=\"text-white/40 text-sm px-6\" data-kid=\"1-4-0-2\">Setiap 1 voice over memotong saldo Rp2.000.</p>\n    </div>\n\n    <div class=\"space-y-8 relative\" data-kid=\"1-4-1\">\n      \n      <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-[#0FFFFF]/5 blur-3xl rounded-full\" data-kid=\"1-4-1-0\"></div>\n\n      \n      <div class=\"rounded-[32px] border border-white/10 bg-white/[0.04] p-8 transition-all relative overflow-hidden\" data-kid=\"1-4-1-1\">\n        <div class=\"absolute -left-10 -top-10 w-32 h-32 bg-white/[0.02] blur-2xl\" data-kid=\"1-4-1-1-0\"></div>\n        <div class=\"flex justify-between items-start mb-8\" data-kid=\"1-4-1-1-1\">\n          <div data-kid=\"1-4-1-1-1-0\">\n            <span class=\"text-[9px] font-black text-white/40 uppercase tracking-[0.2em] block mb-2\" data-kid=\"1-4-1-1-1-0-0\">Starter</span>\n            <h3 class=\"text-2xl font-bold\" data-kid=\"1-4-1-1-1-0-1\">Mulai</h3>\n          </div>\n          <div class=\"text-2xl font-black\" data-kid=\"1-4-1-1-1-1\">Rp20k</div>\n        </div>\n        <div class=\"text-3xl font-black text-[#0FFFFF] mb-3 italic tracking-tighter\" data-kid=\"1-4-1-1-2\">10 <span class=\"text-xs font-bold uppercase not-italic text-white/30 ml-1\" data-kid=\"1-4-1-1-2-0\">Video</span></div>\n        <p class=\"text-white/40 text-xs mb-8 leading-relaxed\" data-kid=\"1-4-1-1-3\">Pas untuk mencoba alur kerja dan mulai produksi konten ringan.</p>\n        <button class=\"w-full py-4 rounded-xl border border-white/20 bg-white/5 text-[10px] font-black uppercase tracking-widest active:bg-white active:text-black\" data-kid=\"1-4-1-1-4\">Pilih Mulai</button>\n      </div>\n\n      \n      <div class=\"rounded-[32px] border-2 border-[#0FFFFF] bg-[#1E2952]/70 p-8 relative shadow-[0_0_50px_rgba(15,255,255,0.12)] scale-[1.03]\" data-kid=\"1-4-1-2\">\n        <div class=\"absolute -top-3.5 left-1/2 -translate-x-1/2 px-5 py-1.5 bg-[#0FFFFF] text-[#010B13] text-[9px] font-black uppercase tracking-[0.2em] rounded-full shadow-lg\" data-kid=\"1-4-1-2-0\">Lebih Irit</div>\n        <div class=\"flex justify-between items-start mb-8 mt-2\" data-kid=\"1-4-1-2-1\">\n          <div data-kid=\"1-4-1-2-1-0\">\n            <span class=\"text-[9px] font-black text-[#0FFFFF] uppercase tracking-[0.2em] block mb-2\" data-kid=\"1-4-1-2-1-0-0\">Popular</span>\n            <h3 class=\"text-2xl font-bold\" data-kid=\"1-4-1-2-1-0-1\">Harian</h3>\n          </div>\n          <div class=\"text-2xl font-black text-[#0FFFFF]\" data-kid=\"1-4-1-2-1-1\">Rp90k</div>\n        </div>\n        <div class=\"text-4xl font-black text-white mb-4 italic tracking-tighter\" data-kid=\"1-4-1-2-2\">50 <span class=\"text-sm font-bold uppercase not-italic text-white/40 ml-1\" data-kid=\"1-4-1-2-2-0\">Video</span></div>\n        <p class=\"text-white/70 text-xs mb-10 leading-relaxed\" data-kid=\"1-4-1-2-3\">Cocok untuk produksi rutin dengan bonus saldo dibanding beli satuan.</p>\n        <button class=\"w-full py-5 rounded-2xl bg-[#0FFFFF] text-[#010B13] text-xs font-black shadow-[0_15px_30px_rgba(15,255,255,0.25)] uppercase tracking-[0.15em]\" data-kid=\"1-4-1-2-4\">\n          Ambil Paket Harian\n        </button>\n      </div>\n\n      \n      <div class=\"rounded-[32px] border border-white/10 bg-white/[0.04] p-8 transition-all relative overflow-hidden\" data-kid=\"1-4-1-3\">\n        <div class=\"absolute -right-10 -bottom-10 w-32 h-32 bg-[#BF00FF]/5 blur-2xl\" data-kid=\"1-4-1-3-0\"></div>\n        <div class=\"flex justify-between items-start mb-8\" data-kid=\"1-4-1-3-1\">\n          <div data-kid=\"1-4-1-3-1-0\">\n            <span class=\"text-[9px] font-black text-white/40 uppercase tracking-[0.2em] block mb-2\" data-kid=\"1-4-1-3-1-0-0\">Business</span>\n            <h3 class=\"text-2xl font-bold\" data-kid=\"1-4-1-3-1-0-1\">Produksi</h3>\n          </div>\n          <div class=\"text-2xl font-black\" data-kid=\"1-4-1-3-1-1\">Rp170k</div>\n        </div>\n        <div class=\"text-3xl font-black text-[#BF00FF] mb-3 italic tracking-tighter\" data-kid=\"1-4-1-3-2\">100 <span class=\"text-xs font-bold uppercase not-italic text-white/30 ml-1\" data-kid=\"1-4-1-3-2-0\">Video</span></div>\n        <p class=\"text-white/40 text-xs mb-8 leading-relaxed\" data-kid=\"1-4-1-3-3\">Pilihan terbaik untuk volume tinggi dan kebutuhan tim kecil.</p>\n        <button class=\"w-full py-4 rounded-xl border border-white/20 bg-white/5 text-[10px] font-black uppercase tracking-widest active:bg-white active:text-black\" data-kid=\"1-4-1-3-4\">Pilih Produksi</button>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"legal\" class=\"px-6 py-24 space-y-12\" data-kid=\"1-5\">\n    <div class=\"text-center\" data-kid=\"1-5-0\">\n      <h2 class=\"text-2xl font-bold tracking-tight\" data-kid=\"1-5-0-0\">Privasi & Aturan</h2>\n    </div>\n    <div class=\"space-y-4\" data-kid=\"1-5-1\">\n      <div class=\"p-8 rounded-[28px] bg-white/[0.03] border border-white/10 relative overflow-hidden\" data-kid=\"1-5-1-0\">\n        <h3 class=\"text-sm font-black uppercase tracking-widest mb-3 flex items-center gap-2 text-[#0FFFFF]\" data-kid=\"1-5-1-0-0\">\n          <i class=\"ti ti-shield-lock text-lg\" data-kid=\"1-5-1-0-0-0\"></i> Data Privasi\n        </h3>\n        <p class=\"text-white/40 text-xs leading-relaxed\" data-kid=\"1-5-1-0-1\">Kami menyimpan riwayat proses dan file hasil untuk operasional layanan. Data Anda aman.</p>\n      </div>\n      <div class=\"p-8 rounded-[28px] bg-white/[0.03] border border-white/10 relative overflow-hidden\" data-kid=\"1-5-1-1\">\n        <h3 class=\"text-sm font-black uppercase tracking-widest mb-3 flex items-center gap-2 text-[#BF00FF]\" data-kid=\"1-5-1-1-0\">\n          <i class=\"ti ti-gavel text-lg\" data-kid=\"1-5-1-1-0-0\"></i> Penggunaan\n        </h3>\n        <p class=\"text-white/40 text-xs leading-relaxed\" data-kid=\"1-5-1-1-1\">Pastikan video yang diunggah memiliki hak penggunaan resmi. Hindari konten spam.</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"pt-20 pb-12 px-10 text-center border-t border-white/[0.03] bg-black\" data-kid=\"1-6\">\n    <div class=\"font-black text-2xl tracking-tighter italic mb-6\" data-kid=\"1-6-0\">VOICESHORT<span class=\"text-[#0FFFFF]\" data-kid=\"1-6-0-0\">.</span></div>\n    <p class=\"text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]\" data-kid=\"1-6-1\">© 2024 Voiceshort AI. Made with Precision.</p>\n  </footer>\n</div>",
