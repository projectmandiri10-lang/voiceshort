      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --ink-black: #010B13;\n    --space-indigo: #0A0F1D;\n    --cyan-glow: #0FFFFF;\n    --hyper-magenta: #BF00FF;\n    --glass-bg: rgba(255, 255, 255, 0.03);\n    --glass-border: rgba(255, 255, 255, 0.08);\n  }\n\n  body {\n    background-color: var(--ink-black);\n    color: white;\n    font-family: 'DM Sans', sans-serif;\n    margin: 0;\n    min-height: 1000px;\n    overflow-x: hidden;\n  }\n\n  .aurora-orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(120px);\n    z-index: -1;\n    opacity: 0.15;\n    pointer-events: none;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.02);\n    backdrop-filter: blur(24px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-radius: 24px;\n    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);\n  }\n\n  .sidebar-item {\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    border: 1px solid transparent;\n  }\n\n  .sidebar-item.active {\n    background: rgba(15, 255, 255, 0.04);\n    border-color: var(--cyan-glow);\n    box-shadow: 0 0 25px rgba(15, 255, 255, 0.15), inset 0 0 15px rgba(15, 255, 255, 0.05);\n  }\n\n  .progress-track {\n    height: 6px;\n    background: rgba(255, 255, 255, 0.06);\n    border-radius: 10px;\n    overflow: hidden;\n    position: relative;\n  }\n\n  .progress-fill {\n    height: 100%;\n    background: linear-gradient(90deg, #0FFFFF, #BF00FF, #0FFFFF);\n    background-size: 200% 100%;\n    border-radius: 10px;\n    position: relative;\n    box-shadow: 0 0 20px rgba(15, 255, 255, 0.5);\n    animation: slide-gradient 3s linear infinite;\n  }\n\n  @keyframes slide-gradient {\n    0% { background-position: 200% 0; }\n    100% { background-position: -200% 0; }\n  }\n\n  .bento-meta-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    grid-auto-rows: 110px;\n    gap: 16px;\n  }\n\n  .meta-card {\n    background: rgba(255, 255, 255, 0.03);\n    border: 1px solid rgba(255, 255, 255, 0.06);\n    border-radius: 20px;\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .meta-card::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 100%);\n    opacity: 0.3;\n    pointer-events: none;\n  }\n\n  .meta-card:hover {\n    border-color: rgba(15, 255, 255, 0.3);\n    background: rgba(255, 255, 255, 0.06);\n    transform: translateY(-5px);\n    box-shadow: 0 10px 30px -10px rgba(15, 255, 255, 0.1);\n  }\n\n  .btn-premium {\n    background: linear-gradient(135deg, #0FFFFF 0%, #00C8C8 100%);\n    color: #010B13;\n    font-weight: 800;\n    font-family: 'Sora', sans-serif;\n    border-radius: 18px;\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    position: relative;\n    z-index: 1;\n    border: none;\n    cursor: pointer;\n  }\n\n  .btn-premium:hover:not(:disabled) {\n    transform: translateY(-3px) scale(1.02);\n    box-shadow: \n      0 0 40px rgba(15, 255, 255, 0.5),\n      0 10px 20px rgba(0, 0, 0, 0.2);\n  }\n\n  .btn-premium:active:not(:disabled) {\n    transform: scale(0.98);\n  }\n\n  .btn-premium:disabled {\n    background: rgba(255, 255, 255, 0.05);\n    color: rgba(255, 255, 255, 0.15);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n    cursor: not-allowed;\n  }\n\n  .pulse-border {\n    animation: pulse-glow 2s infinite alternate;\n  }\n\n  @keyframes pulse-glow {\n    from { box-shadow: 0 0 10px rgba(15, 255, 255, 0.2); }\n    to { box-shadow: 0 0 20px rgba(15, 255, 255, 0.5); }\n  }\n\n  .custom-scrollbar::-webkit-scrollbar { width: 5px; }\n  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }\n  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }\n</style>\n\n<div class=\"aurora-orb w-[600px] h-[600px] bg-cyan-500 top-[-200px] left-[-200px]\" data-kid=\"1\"></div>\n<div class=\"aurora-orb w-[500px] h-[500px] bg-purple-600 bottom-[-100px] right-[-100px]\" data-kid=\"2\"></div>\n<div class=\"aurora-orb w-[400px] h-[400px] bg-blue-500 top-[20%] right-[5%]\" data-kid=\"3\"></div>\n<div class=\"aurora-orb w-[300px] h-[300px] bg-magenta-500 top-[60%] left-[20%] opacity-10\" data-kid=\"4\"></div>\n\n<div class=\"max-w-[1440px] mx-auto p-12 min-h-[900px] relative z-10\" data-kid=\"5\">\n  \n  <header class=\"flex justify-between items-center mb-12\" data-kid=\"5-0\">\n    <div data-kid=\"5-0-0\">\n      <h1 class=\"text-5xl font-bold font-['Sora'] text-white tracking-tight mb-3\" data-kid=\"5-0-0-0\">Riwayat Proses</h1>\n      <p class=\"text-white/50 text-xl font-medium\" data-kid=\"5-0-0-1\">Monitoring real-time produksi video pendek Anda.</p>\n    </div>\n    <div class=\"flex gap-4\" data-kid=\"5-0-1\">\n      <button class=\"bg-white/5 border border-white/10 px-8 py-4 rounded-2xl flex items-center gap-3 font-semibold hover:bg-white/10 transition-all\" data-kid=\"5-0-1-0\">\n        <i class=\"ti ti-refresh text-xl text-cyan-400\" data-kid=\"5-0-1-0-0\"></i>\n        Muat Ulang\n      </button>\n    </div>\n  </header>\n\n  <div class=\"grid grid-cols-12 gap-10\" data-kid=\"5-1\">\n    \n    <aside class=\"col-span-4 glass-card p-8 h-[820px] flex flex-col\" data-kid=\"5-1-0\">\n      <div class=\"flex justify-between items-center mb-8\" data-kid=\"5-1-0-0\">\n        <h3 class=\"font-['Sora'] font-bold text-xl text-white/90\" data-kid=\"5-1-0-0-0\">Daftar Proses</h3>\n        <span class=\"bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 px-3 py-1 rounded-full text-xs font-bold\" data-kid=\"5-1-0-0-1\">12 TOTAL</span>\n      </div>\n\n      <div class=\"flex-1 overflow-y-auto space-y-5 pr-3 custom-scrollbar\" data-kid=\"5-1-0-1\">\n        \n        <div class=\"sidebar-item active p-6 rounded-3xl cursor-pointer\" data-kid=\"5-1-0-1-0\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"5-1-0-1-0-0\">\n            <h4 class=\"font-bold text-white text-lg truncate max-w-[200px]\" data-kid=\"5-1-0-1-0-0-0\">TikTok Viral #1</h4>\n            <span class=\"bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 px-2 py-1 rounded-lg text-[10px] font-black flex items-center gap-1.5 uppercase tracking-tighter pulse\" data-kid=\"5-1-0-1-0-0-1\">\n              <i class=\"ti ti-loader-2 animate-spin\" data-kid=\"5-1-0-1-0-0-1-0\"></i> Running\n            </span>\n          </div>\n          <p class=\"text-sm text-white/40 mb-4 font-medium\" data-kid=\"5-1-0-1-0-1\">E-learning & Edukasi</p>\n          <div class=\"progress-track h-2\" data-kid=\"5-1-0-1-0-2\">\n            <div class=\"progress-fill w-[72%]\" data-kid=\"5-1-0-1-0-2-0\"></div>\n          </div>\n        </div>\n\n        \n        <div class=\"sidebar-item p-6 rounded-3xl bg-white/3 border border-white/5 hover:border-white/20 cursor-pointer\" data-kid=\"5-1-0-1-1\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"5-1-0-1-1-0\">\n            <h4 class=\"font-bold text-white/80 text-lg truncate max-w-[200px]\" data-kid=\"5-1-0-1-1-0-0\">Review iPhone 15</h4>\n            <span class=\"bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-1 rounded-lg text-[10px] font-black flex items-center gap-1.5 uppercase tracking-tighter\" data-kid=\"5-1-0-1-1-0-1\">\n              <i class=\"ti ti-circle-check\" data-kid=\"5-1-0-1-1-0-1-0\"></i> Success\n            </span>\n          </div>\n          <p class=\"text-sm text-white/30 font-medium\" data-kid=\"5-1-0-1-1-1\">Review Produk</p>\n        </div>\n\n        \n        <div class=\"sidebar-item p-6 rounded-3xl bg-white/3 border border-white/5 hover:border-white/20 cursor-pointer\" data-kid=\"5-1-0-1-2\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"5-1-0-1-2-0\">\n            <h4 class=\"font-bold text-white/80 text-lg truncate max-w-[200px]\" data-kid=\"5-1-0-1-2-0-0\">Rendang Recipe</h4>\n            <span class=\"bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-1 rounded-lg text-[10px] font-black flex items-center gap-1.5 uppercase tracking-tighter\" data-kid=\"5-1-0-1-2-0-1\">\n              <i class=\"ti ti-circle-check\" data-kid=\"5-1-0-1-2-0-1-0\"></i> Success\n            </span>\n          </div>\n          <p class=\"text-sm text-white/30 font-medium\" data-kid=\"5-1-0-1-2-1\">Kuliner</p>\n        </div>\n\n        \n        <div class=\"sidebar-item p-6 rounded-3xl bg-white/3 border border-white/5 hover:border-white/20 cursor-pointer\" data-kid=\"5-1-0-1-3\">\n          <div class=\"flex justify-between items-start mb-3\" data-kid=\"5-1-0-1-3-0\">\n            <h4 class=\"font-bold text-white/80 text-lg truncate max-w-[200px]\" data-kid=\"5-1-0-1-3-0-0\">Daily Vlog</h4>\n            <span class=\"bg-red-500/10 text-red-400 border border-red-500/20 px-2 py-1 rounded-lg text-[10px] font-black flex items-center gap-1.5 uppercase tracking-tighter\" data-kid=\"5-1-0-1-3-0-1\">\n              <i class=\"ti ti-alert-circle\" data-kid=\"5-1-0-1-3-0-1-0\"></i> Failed\n            </span>\n          </div>\n          <p class=\"text-sm text-white/30 font-medium\" data-kid=\"5-1-0-1-3-1\">Lifestyle</p>\n        </div>\n      </div>\n    </aside>\n\n    \n    <main class=\"col-span-8 glass-card p-12 h-[820px] overflow-y-auto custom-scrollbar\" data-kid=\"5-1-1\">\n      <div class=\"flex justify-between items-start mb-12\" data-kid=\"5-1-1-0\">\n        <div data-kid=\"5-1-1-0-0\">\n          <h2 class=\"text-4xl font-black font-['Sora'] text-white mb-2 tracking-tight\" data-kid=\"5-1-1-0-0-0\">Detail Produksi</h2>\n          <p class=\"text-white/40 text-lg\" data-kid=\"5-1-1-0-0-1\">Pantau status rendering dan aset output di bawah ini.</p>\n        </div>\n        <div class=\"bg-white/5 border border-white/10 px-6 py-3 rounded-2xl flex items-center gap-3\" data-kid=\"5-1-1-0-1\">\n          <div class=\"w-2.5 h-2.5 bg-cyan-400 rounded-full animate-pulse shadow-[0_0_10px_#0FFFFF]\" data-kid=\"5-1-1-0-1-0\"></div>\n          <span class=\"font-black text-xs uppercase tracking-widest text-cyan-400\" data-kid=\"5-1-1-0-1-1\">Status: Running</span>\n        </div>\n      </div>\n\n      \n      <div class=\"relative mb-12\" data-kid=\"5-1-1-1\">\n        <div class=\"bg-gradient-to-br from-white/10 to-transparent p-[1px] rounded-[32px]\" data-kid=\"5-1-1-1-0\">\n          <div class=\"bg-[#0A0F1D]/80 backdrop-blur-xl p-10 rounded-[31px] border border-white/5\" data-kid=\"5-1-1-1-0-0\">\n            <div class=\"flex justify-between items-end mb-8\" data-kid=\"5-1-1-1-0-0-0\">\n              <div data-kid=\"5-1-1-1-0-0-0-0\">\n                <span class=\"text-cyan-400 font-black text-xs tracking-widest uppercase mb-2 block\" data-kid=\"5-1-1-1-0-0-0-0-0\">Step 3 of 4</span>\n                <h3 class=\"text-2xl font-bold font-['Sora'] text-white\" data-kid=\"5-1-1-1-0-0-0-0-1\">Generating Voice Audio...</h3>\n              </div>\n              <div class=\"text-right\" data-kid=\"5-1-1-1-0-0-0-1\">\n                <span class=\"text-5xl font-black text-white leading-none tracking-tighter\" data-kid=\"5-1-1-1-0-0-0-1-0\">72<span class=\"text-cyan-400 text-3xl\" data-kid=\"5-1-1-1-0-0-0-1-0-0\">%</span></span>\n              </div>\n            </div>\n            <div class=\"progress-track h-6 rounded-2xl mb-6\" data-kid=\"5-1-1-1-0-0-1\">\n              <div class=\"progress-fill w-[72%] h-full rounded-2xl\" data-kid=\"5-1-1-1-0-0-1-0\"></div>\n            </div>\n            <div class=\"flex items-center gap-3 py-3 px-5 bg-white/5 rounded-xl border border-white/5\" data-kid=\"5-1-1-1-0-0-2\">\n              <i class=\"ti ti-sparkles text-cyan-400 text-xl\" data-kid=\"5-1-1-1-0-0-2-0\"></i>\n              <p class=\"text-sm text-white/60 font-medium\" data-kid=\"5-1-1-1-0-0-2-1\">Artificial Intelligence sedang menyesuaikan intonasi dengan tone <span class=\"text-white font-bold\" data-kid=\"5-1-1-1-0-0-2-1-0\">Semangat</span>.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"bento-meta-grid mb-12\" data-kid=\"5-1-1-2\">\n        <div class=\"meta-card col-span-3\" data-kid=\"5-1-1-2-0\">\n          <span class=\"text-[10px] text-white/40 uppercase tracking-[0.2em] font-black mb-2\" data-kid=\"5-1-1-2-0-0\">Judul Project</span>\n          <strong class=\"text-2xl font-bold font-['Sora'] text-white truncate drop-shadow-sm\" data-kid=\"5-1-1-2-0-1\">Bikin video TikTok viral dengan narasi AI Terbaru 2024</strong>\n        </div>\n        <div class=\"meta-card\" data-kid=\"5-1-1-2-1\">\n          <span class=\"text-[10px] text-white/40 uppercase tracking-[0.2em] font-black mb-2\" data-kid=\"5-1-1-2-1-0\">Durasi</span>\n          <strong class=\"text-xl font-bold font-['Sora'] text-white\" data-kid=\"5-1-1-2-1-1\">59.20 s</strong>\n        </div>\n        <div class=\"meta-card\" data-kid=\"5-1-1-2-2\">\n          <span class=\"text-[10px] text-white/40 uppercase tracking-[0.2em] font-black mb-2\" data-kid=\"5-1-1-2-2-0\">Kategori</span>\n          <strong class=\"text-xl font-bold font-['Sora'] text-white\" data-kid=\"5-1-1-2-2-1\">E-learning</strong>\n        </div>\n        <div class=\"meta-card\" data-kid=\"5-1-1-2-3\">\n          <span class=\"text-[10px] text-white/40 uppercase tracking-[0.2em] font-black mb-2\" data-kid=\"5-1-1-2-3-0\">Gender</span>\n          <strong class=\"text-xl font-bold font-['Sora'] text-white\" data-kid=\"5-1-1-2-3-1\">Laki-laki</strong>\n        </div>\n        <div class=\"meta-card\" data-kid=\"5-1-1-2-4\">\n          <span class=\"text-[10px] text-white/40 uppercase tracking-[0.2em] font-black mb-2\" data-kid=\"5-1-1-2-4-0\">Tone</span>\n          <strong class=\"text-xl font-bold font-['Sora'] text-white\" data-kid=\"5-1-1-2-4-1\">Semangat</strong>\n        </div>\n        <div class=\"meta-card\" data-kid=\"5-1-1-2-5\">\n          <span class=\"text-[10px] text-white/40 uppercase tracking-[0.2em] font-black mb-2\" data-kid=\"5-1-1-2-5-0\">ID Transaksi</span>\n          <strong class=\"text-lg font-bold font-['Sora'] text-cyan-400 tracking-widest\" data-kid=\"5-1-1-2-5-1\">#99281X-RENDER</strong>\n        </div>\n      </div>\n\n      \n      <div class=\"grid grid-cols-2 gap-8 mb-12\" data-kid=\"5-1-1-3\">\n        <div class=\"glass-card p-8 bg-white/[0.01]\" data-kid=\"5-1-1-3-0\">\n          <h4 class=\"text-xs text-white/30 uppercase tracking-widest font-black mb-4\" data-kid=\"5-1-1-3-0-0\">Brief Deskripsi</h4>\n          <p class=\"text-white/70 leading-relaxed font-medium\" data-kid=\"5-1-1-3-0-1\">Buat narasi yang menggugah untuk video pendek berdurasi 60 detik. Fokus pada tips produktivitas di pagi hari dengan bahasa yang santai namun profesional. Pastikan ada penekanan pada poin-poin penting.</p>\n        </div>\n        <div class=\"glass-card p-8 bg-white/[0.01]\" data-kid=\"5-1-1-3-1\">\n          <h4 class=\"text-xs text-white/30 uppercase tracking-widest font-black mb-4\" data-kid=\"5-1-1-3-1-0\">CTA Text Content</h4>\n          <p class=\"text-cyan-400 font-bold text-xl italic leading-tight\" data-kid=\"5-1-1-3-1-1\">\"Klik link di bio untuk mendapatkan template gratis sekarang juga!\"</p>\n        </div>\n      </div>\n\n      \n      <div class=\"flex flex-wrap gap-5 mb-12\" data-kid=\"5-1-1-4\">\n        <button class=\"btn-premium px-10 py-5 flex items-center gap-4 text-lg disabled:opacity-40\" disabled data-kid=\"5-1-1-4-0\">\n          <i class=\"ti ti-download text-2xl\" data-kid=\"5-1-1-4-0-0\"></i>\n          Download Caption\n        </button>\n        <button class=\"btn-premium px-10 py-5 flex items-center gap-4 text-lg disabled:opacity-40\" disabled data-kid=\"5-1-1-4-1\">\n          <i class=\"ti ti-video text-2xl\" data-kid=\"5-1-1-4-1-0\"></i>\n          Download Final Video\n        </button>\n        <div class=\"w-full flex items-center gap-3 px-6 py-4 bg-white/5 rounded-2xl border border-white/5 border-dashed\" data-kid=\"5-1-1-4-2\">\n          <i class=\"ti ti-info-circle text-white/30 text-xl\" data-kid=\"5-1-1-4-2-0\"></i>\n          <p class=\"text-sm text-white/30 italic\" data-kid=\"5-1-1-4-2-1\">Aset unduhan akan tersedia secara otomatis setelah proses rendering 100% selesai.</p>\n        </div>\n      </div>\n\n      \n      <div class=\"pt-10 border-t border-white/10 flex justify-between items-center\" data-kid=\"5-1-1-5\">\n        <div class=\"flex gap-4\" data-kid=\"5-1-1-5-0\">\n          <button class=\"bg-white/5 border border-white/10 px-6 py-3 rounded-xl text-sm font-bold text-white/60 hover:text-white hover:bg-white/10 transition-all flex items-center gap-2\" data-kid=\"5-1-1-5-0-0\">\n            <i class=\"ti ti-folder-open text-lg\" data-kid=\"5-1-1-5-0-0-0\"></i>\n            Output Folder\n          </button>\n          <button class=\"bg-white/5 border border-white/10 px-6 py-3 rounded-xl text-sm font-bold text-white/60 hover:text-white hover:bg-white/10 transition-all flex items-center gap-2 disabled:opacity-30 disabled:cursor-not-allowed\" disabled data-kid=\"5-1-1-5-0-1\">\n            <i class=\"ti ti-rotate text-lg\" data-kid=\"5-1-1-5-0-1-0\"></i>\n            Retry Process\n          </button>\n        </div>\n        <button class=\"text-red-500/60 font-bold text-sm hover:text-red-400 transition-colors flex items-center gap-2 px-6 py-3\" data-kid=\"5-1-1-5-1\">\n          <i class=\"ti ti-trash text-lg\" data-kid=\"5-1-1-5-1-0\"></i>\n          Delete Project\n        </button>\n      </div>\n    </main>\n  </div>\n</div>",
