# Cloudflare Worker secrets / local wrangler env
AIVENE_API_KEY=your_aivene_api_key
AIVENE_BASE_URL=https://api.aivene.com/v1
AIVENE_SCRIPT_MODEL=gemini-2.5-pro
AIVENE_TTS_MODEL=tts-1-hd
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_publishable_or_anon_key
GENERATE_PRICE_IDR=2000

# Optional if billing QRIS is enabled
# WEBQRIS_BASE_URL=https://webqris.com
# WEBQRIS_API_TOKEN=your_webqris_api_token
# WEBQRIS_WEBHOOK_SECRET=your_webqris_webhook_secret

# Frontend build env
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Local dev only: Vite (5174) -> Wrangler dev (8787)
VITE_API_BASE=http://localhost:8787

# Legacy Node backend env below is optional and only needed if you intentionally run apps/server.
AI_PROVIDER=aivene
SCRIPT_PROVIDER=aivene
SCRIPT_FALLBACK_PROVIDER=openrouter
TTS_PROVIDER=aivene
TTS_FALLBACK_PROVIDER=openrouter
PORT=8788
WEB_ORIGIN=http://localhost:5174
APP_WEB_URL=http://localhost:5174
APP_API_URL=http://localhost:8788
APP_PROD_WEB_URL=http://localhost:5174
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:5174
SUCCESS_OUTPUT_RETENTION_HOURS=72
APP_STORAGE_ROOT=./
SUPERADMIN_EMAIL=your-superadmin@example.com
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_client_secret
SUPERADMIN_PASSWORD=your_initial_superadmin_password_bootstrap_only

# Optional overrides for media tools on legacy Node backend
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
